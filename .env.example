# ===== 環境変数のひな形 =====
# このファイルを .env.local にコピーして値を埋めてください（.env.local はコミットされません）。
#   PowerShell: Copy-Item .env.example .env.local

# --- Supabase（Settings → API Keys で確認）---
# プロジェクトの URL（例：https://xxxxxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=
# 公開鍵（sb_publishable_... で始まる）。ブラウザに出てよい。読み書きの範囲は RLS が守る
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 補足：同じ画面にある secret key（sb_secret_...）はこのアプリでは使いません。
# 他人のデータを守る仕組みは RLS（行ごとのアクセス制限）が担っているためです（README §5-5）。

# --- OpenAI（platform.openai.com → API keys）---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Sheets（サービスアカウントの JSON から転記）---
# client_email の値
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# private_key の値。改行は \n のまま 1 行で貼り付け、全体をダブルクォートで囲む
GOOGLE_PRIVATE_KEY=""
