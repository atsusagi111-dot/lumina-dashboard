# ===== 環境変数のひな形 =====
# このファイルを .env.local にコピーして値を埋めてください（.env.local はコミットされません）。
#   PowerShell: Copy-Item .env.example .env.local

# --- Supabase（Settings → API で確認）---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー側専用。ブラウザに出してはいけないので NEXT_PUBLIC_ を付けない
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI（platform.openai.com → API keys）---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Sheets（サービスアカウントの JSON から転記）---
# client_email の値
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# private_key の値。改行は \n のまま 1 行で貼り付け、全体をダブルクォートで囲む
GOOGLE_PRIVATE_KEY=""
